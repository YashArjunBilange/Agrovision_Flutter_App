# AgroVision Backend Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to Git

# JWT Authentication (REQUIRED for production)
SECRET_KEY=replace_with_secure_random_value

# Database (defaults to SQLite if not set)
# DATABASE_URL=postgresql://username:password@host/database

# Gemini AI Assistant (optional - local knowledge base works without it)
# AI_API_KEY=your_gemini_api_key

# Weather (optional - Open-Meteo free tier works without it)
# WEATHER_API_KEY=

# ML Model (defaults already set in config.py)
# LEGACY_MODEL_PATH=best.pt
# MAIZE_CONFIDENCE_THRESHOLD=0.40
